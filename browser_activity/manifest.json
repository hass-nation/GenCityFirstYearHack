{
  "manifest_version": 3,
  "name": "PC Pet Tab Snapshot",
  "version": "0.2.0",
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{ "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"] }],
  "action": { "default_popup": "popup.html" }
}
